# =============================================================================
#  Production env for docker-compose.prod.yml.  Copy to .env and fill in.
#  Compose auto-loads .env for both build-arg substitution and container env.
# =============================================================================

# --- Public URLs (how a browser reaches your box) ----------------------------
# Replace 203.0.113.10 with your VM's public IP. The API URL is baked into the
# frontend at build time, so rebuild (--build) if you change it.
PUBLIC_API_URL=http://203.0.113.10:4000
CORS_ORIGIN=http://203.0.113.10:3000

# --- HTTPS via Caddy (optional; run with `--profile https`) ------------------
# Point your domain's DNS A-record at the VM, then set DOMAIN and switch the two
# URLs above to: PUBLIC_API_URL=https://yourdomain.com/api  CORS_ORIGIN=https://yourdomain.com
# A free subdomain works too, e.g. yourname.duckdns.org.
DOMAIN=yourdomain.com

# --- Database (the postgres service below) -----------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_something_strong
POSTGRES_DB=postgres
# Keep this in sync with the three values above (host is the compose service name):
DATABASE_URL=postgresql://postgres:change_me_to_something_strong@postgres:5432/postgres

# --- Redis (the redis service below) -----------------------------------------
REDIS_URL=redis://redis:6379

# --- Auth --------------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
PORT=4000
# Number of trusted proxy hops in front of the API (Tailscale Funnel / Caddy / Nginx).
# Affects how the real client IP is derived for IP-based rate limits. Default 1.
TRUST_PROXY=1

# --- Solana ------------------------------------------------------------------
# The public devnet RPC is free but heavily rate-limited — it WILL bottleneck the
# trigger/worker under real traffic. For anything beyond a demo, get a free
# dedicated RPC (Helius/QuickNode) and set SOLANA_RPC_URL to it; the websocket
# endpoint is derived automatically (so SOLANA_WS_URL can stay blank unless your
# provider uses a different ws host).
#   e.g. SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=
# The browser (wallet page) talks to Solana directly — point it at the same RPC.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# Frontend reads these for delegation UI (devnet defaults match the apps).
NEXT_PUBLIC_OPERATOR_PUBKEY=FgCiArPJfe9YCfW8Gioo87uoG7M9zXiPg8JvJHK3uTtJ

# Signer for on-chain actions (solana-keygen JSON array or base58). Leave empty
# to keep on-chain actions "simulated". MUST be funded on the active cluster.
SOLANA_SIGNER_SECRET_KEY=

# Deployed program + Wormhole core bridge (devnet defaults already in the apps).
WEB3_ZAPIER_PROGRAM_ID=3UDvaK5Xxa7JsGUF3peRzbgspk5ASUQxCQEfhibj7Rjs
WORMHOLE_CORE_BRIDGE=3u8hJUVTA4jH1wYAyUur7FFZVQ8H635K3tSHHF4ssjQ5

# --- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=5

# --- Failure alerts (optional) -----------------------------------------------
# Discord-compatible webhook; a failed/partial workflow run posts a summary here.
FAILURE_WEBHOOK_URL=

# --- Email (optional; send_email simulates if unset) -------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pulsar <noreply@pulsar.dev>
