# =============================================================================
#  Production env for docker-compose.prod.yml.  Copy to .env and fill in.
#  Compose auto-loads .env for both build-arg substitution and container env.
# =============================================================================

# --- Public URLs (how a browser reaches your box) ----------------------------
# Replace 203.0.113.10 with your VM's public IP. The API URL is baked into the
# frontend at build time, so rebuild (--build) if you change it.
PUBLIC_API_URL=http://203.0.113.10:4000
CORS_ORIGIN=http://203.0.113.10:3000

# --- HTTPS via Caddy (optional; run with `--profile https`) ------------------
# Point your domain's DNS A-record at the VM, then set DOMAIN and switch the two
# URLs above to: PUBLIC_API_URL=https://yourdomain.com/api  CORS_ORIGIN=https://yourdomain.com
# A free subdomain works too, e.g. yourname.duckdns.org.
DOMAIN=yourdomain.com

# --- Database (the postgres service below) -----------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_something_strong
POSTGRES_DB=postgres
# Keep this in sync with the three values above (host is the compose service name):
DATABASE_URL=postgresql://postgres:change_me_to_something_strong@postgres:5432/postgres

# --- Redis -------------------------------------------------------------------
# Single endpoint (dev, or a managed Redis like Upstash/ElastiCache):
REDIS_URL=redis://redis:6379
# HA via Sentinel (removes the single-Redis SPOF). Set these to switch the whole
# stack to Sentinel — clients then follow a primary failover automatically. See
# docker-compose.redis-ha.yml for the topology.
#   REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
#   REDIS_MASTER_NAME=mymaster
#   REDIS_PASSWORD=            # if the data nodes require auth
#   REDIS_SENTINEL_PASSWORD=   # if the sentinels require a separate auth

# --- Auth --------------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
PORT=4000
# Number of trusted proxy hops in front of the API (Tailscale Funnel / Caddy / Nginx).
# Affects how the real client IP is derived for IP-based rate limits. Default 1.
TRUST_PROXY=1

# --- Solana ------------------------------------------------------------------
# The public devnet RPC is free but heavily rate-limited — it WILL bottleneck the
# trigger/worker under real traffic. For anything beyond a demo, get a dedicated
# RPC. The websocket endpoint is derived from SOLANA_RPC_URL unless set explicitly.
#   Helius (full pubsub):  SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=KEY
#                          (leave SOLANA_WS_URL blank — derived)
#
# IMPORTANT: some providers offer HTTP RPC but NO Solana websocket subscriptions
# (e.g. Alchemy: slot/logs/account/programSubscribe all return "method not found").
# The trigger service is 100% subscription-based, so with such a provider you MUST
# point SOLANA_WS_URL at a pubsub-capable endpoint (public devnet, or Helius):
#   SOLANA_RPC_URL=https://solana-devnet.g.alchemy.com/v2/KEY   # HTTP load
#   SOLANA_WS_URL=wss://api.devnet.solana.com                   # subscriptions
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=
# RPC failover (HA): give the trigger-service multiple endpoints (same cluster).
# It probes the active one and rotates on an unreachable OR stalled node, so the
# leader can't be "alive but blind". Use 2+ DIFFERENT providers for real HA.
#   SOLANA_RPC_URLS=https://api.devnet.solana.com,https://devnet.helius-rpc.com/?api-key=KEY
# Tuning: RPC_HEALTH_MS (probe interval), RPC_FAIL_THRESHOLD, RPC_STALL_THRESHOLD.

# --- Mainnet (optional) — enables the per-workflow "Mainnet" option ---
# Leave BLANK to run devnet-only (default, exactly like before). Set a mainnet RPC
# to let users build MAINNET workflows: monitoring triggers + off-chain actions
# only (alerts, webhooks) — fund-moving actions stay devnet-only, so no real funds
# and no mainnet program deploy are involved. Presence of SOLANA_RPC_URL_MAINNET is
# the on/off switch (the API rejects mainnet workflows when it's blank).
#   - Worker reads SOLANA_RPC_URL_MAINNET (chain reads for mainnet workflows).
#   - Trigger-service reads SOLANA_RPC_URLS_MAINNET (one or more, same cluster).
# Use a real provider (Helius/Alchemy mainnet) — the public mainnet RPC rate-limits hard.
SOLANA_RPC_URL_MAINNET=
SOLANA_WS_URL_MAINNET=
SOLANA_RPC_URLS_MAINNET=

# The browser (wallet page) talks to Solana directly and uses websocket confirmation
# (signatureSubscribe), so keep it on a pubsub-capable endpoint (NOT a HTTP-only one).
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# Frontend reads these for delegation UI (devnet defaults match the apps).
NEXT_PUBLIC_OPERATOR_PUBKEY=FgCiArPJfe9YCfW8Gioo87uoG7M9zXiPg8JvJHK3uTtJ

# Signer for on-chain actions (solana-keygen JSON array or base58). Leave empty
# to keep on-chain actions "simulated". MUST be funded on the active cluster.
SOLANA_SIGNER_SECRET_KEY=

# Deployed program (operator-specific — set per deployment).
WEB3_ZAPIER_PROGRAM_ID=3UDvaK5Xxa7JsGUF3peRzbgspk5ASUQxCQEfhibj7Rjs
# Treasury that collects the 0.5% platform fee. Must match the on-chain TREASURY
# constant in the program. Defaults to the operator wallet.
# TREASURY_PUBKEY=

# Cluster-specific program addresses (Raydium CPMM, Wormhole core bridge, Metaplex)
# auto-resolve from SOLANA_RPC_URL — set these ONLY to override a custom deployment.
# RAYDIUM_CPMM_PROGRAM=
# WORMHOLE_CORE_BRIDGE=

# --- Going to mainnet (config flip) ------------------------------------------
# 1. Redeploy the program to mainnet-beta; set WEB3_ZAPIER_PROGRAM_ID + NEXT_PUBLIC_PROGRAM_ID.
# 2. Point all RPCs at mainnet:
#      SOLANA_RPC_URL / NEXT_PUBLIC_SOLANA_RPC = https://api.mainnet-beta.solana.com (or Helius/Alchemy mainnet)
#    Raydium/Wormhole/Metaplex addresses then resolve to mainnet automatically.
# 3. Fund SOLANA_SIGNER_SECRET_KEY (operator) with real SOL; set TREASURY_PUBKEY for the cut.
# 4. Liquidity features (swaps, price triggers, real pools) start working — no code change.

# --- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=5

# --- Failure alerts (optional) -----------------------------------------------
# Discord-compatible webhook; a failed/partial workflow run posts a summary here.
FAILURE_WEBHOOK_URL=

# --- Email (optional; send_email simulates if unset) -------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pulsar <noreply@pulsar.dev>
