{
  "name": "web3-zapier",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run prisma:generate --workspace=backend",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:worker": "npm run dev --workspace=worker",
    "dev:trigger": "npm run dev --workspace=trigger-service",
    "dev:frontend": "npm run dev --workspace=frontend",
    "fund:signer": "node scripts/fund-signer.cjs",
    "mint:create": "node scripts/create-test-mint.cjs"
  },
  "overrides": {
    "ioredis": "5.10.1",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.0.12",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@9.5.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "prisma": "^5.18.0"
  }
}
